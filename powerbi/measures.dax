// ============================================================
// NHANES CHD dashboard - DAX measures
// Paste each block into Power BI Desktop: Modeling > New measure.
// Table names assume the CSVs were loaded with their file names
// (nhanes_chd_cohort, prevalence_by_group, model_comparison, ...).
// ============================================================

// ---------- Cohort (fact table: nhanes_chd_cohort, one row per SEQN) ----------

Participants =
DISTINCTCOUNT ( nhanes_chd_cohort[SEQN] )

CHD Cases =
SUM ( nhanes_chd_cohort[CHD_Flag] )

CHD Prevalence =
DIVIDE ( [CHD Cases], [Participants] )

// Reference line that ignores slicers, so every bar is compared with the whole cohort
CHD Prevalence (All Adults) =
CALCULATE ( [CHD Prevalence], ALL ( nhanes_chd_cohort ) )

Prevalence vs All Adults =
[CHD Prevalence] - [CHD Prevalence (All Adults)]

Median Age =
MEDIAN ( nhanes_chd_cohort[Age] )

Share Female =
DIVIDE (
    CALCULATE ( [Participants], nhanes_chd_cohort[Sex] = "Female" ),
    [Participants]
)

// Text for a KPI card subtitle, e.g. "232 of 5,751 adults"
CHD Cases Label =
FORMAT ( [CHD Cases], "#,0" ) & " of " & FORMAT ( [Participants], "#,0" ) & " adults"

// Hide groups that are too small to show a stable rate (use as a visual-level filter: >= 1)
Group Is Large Enough =
IF ( [Participants] >= 30, 1, 0 )

// ---------- Missingness, computed live from the fact table ----------
// (missingness.csv is also provided if you prefer a static table)

Missing Triglycerides % =
DIVIDE (
    COUNTROWS ( FILTER ( nhanes_chd_cohort, ISBLANK ( nhanes_chd_cohort[Triglycerides] ) ) ),
    [Participants]
)

Missing Blood Pressure % =
DIVIDE (
    COUNTROWS ( FILTER ( nhanes_chd_cohort, ISBLANK ( nhanes_chd_cohort[SystolicBP] ) ) ),
    [Participants]
)

// ---------- Data audit (funnel table) ----------

Rows Before Dedup =
CALCULATE ( MAX ( funnel[Count] ), funnel[Order] = 3 )   // rows with a valid CHD label

Participants After Dedup =
CALCULATE ( MAX ( funnel[Count] ), funnel[Order] = 4 )   // unique participants with a valid label

Inflation Factor =
DIVIDE ( [Rows Before Dedup], [Participants After Dedup] )   // 2.63x

Inflation Label =
FORMAT ( [Inflation Factor], "0.0" ) & "x rows per person"

// ---------- Model comparison (model_comparison: one row per Model x Setup) ----------

AUC Original =
CALCULATE (
    MAX ( model_comparison[AUC] ),
    model_comparison[Setup] = "Original (row-level split)"
)

AUC Corrected =
CALCULATE (
    MAX ( model_comparison[AUC] ),
    model_comparison[Setup] = "Corrected (participant-level CV)"
)

AUC Drop =
[AUC Original] - [AUC Corrected]

AUC Drop Label =
VAR d = [AUC Drop]
RETURN IF ( d > 0.02, "-" & FORMAT ( d, "0.000" ), "about the same" )

Best Corrected Model =
VAR t =
    TOPN (
        1,
        FILTER ( model_comparison, model_comparison[Setup] = "Corrected (participant-level CV)" ),
        model_comparison[AUC], DESC
    )
RETURN MAXX ( t, model_comparison[Model] )

Sensitivity Corrected =
CALCULATE (
    MAX ( model_comparison[Sensitivity] ),
    model_comparison[Setup] = "Corrected (participant-level CV)"
)

Specificity Corrected =
CALCULATE (
    MAX ( model_comparison[Specificity] ),
    model_comparison[Setup] = "Corrected (participant-level CV)"
)

// ---------- Leakage card (static number from the audit notebook, section 4) ----------
// 75.4% of original test rows had an exact copy in the SMOTE training set.
// Put it in a one-row table "leakage" (Metric, Value) or hard-code it in a card:
Leaked Test Rows % = 0.754
Leaked CHD Test Rows % = 0.978

// ---------- Threshold curve (threshold_curve: Model x Threshold) ----------

Selected Threshold =
SELECTEDVALUE ( threshold_curve[Threshold], 0.5 )   // bind a slicer (single value) to Threshold

Sensitivity at Threshold =
CALCULATE (
    MAX ( threshold_curve[Sensitivity] ),
    threshold_curve[Threshold] = [Selected Threshold],
    threshold_curve[Model] = "Logistic regression"
)

Specificity at Threshold =
CALCULATE (
    MAX ( threshold_curve[Specificity] ),
    threshold_curve[Threshold] = [Selected Threshold],
    threshold_curve[Model] = "Logistic regression"
)

Flagged Adults at Threshold =
CALCULATE (
    MAX ( threshold_curve[FlaggedShare] ),
    threshold_curve[Threshold] = [Selected Threshold],
    threshold_curve[Model] = "Logistic regression"
) * [Participants After Dedup]

// ---------- Odds ratios (lr_odds_ratios: one row per feature) ----------

OR Error Low =
MAX ( lr_odds_ratios[OddsRatio] ) - MAX ( lr_odds_ratios[CI_low] )

OR Error High =
MAX ( lr_odds_ratios[CI_high] ) - MAX ( lr_odds_ratios[OddsRatio] )

OR Direction Color =
IF ( MAX ( lr_odds_ratios[OddsRatio] ) >= 1, "#1A73E8", "#9AA0A6" )   // use in conditional formatting > field value

// ---------- Survey-weighted estimates (page 3) ----------
// Point estimates can be computed live from the fact table because WTMEC2YR is in it.
// Design-based CIs cannot be computed in DAX (they need strata/PSU variance); take them from weighted_prevalence.

Weighted Prevalence (live) =
DIVIDE (
    SUMX ( nhanes_chd_cohort, nhanes_chd_cohort[WTMEC2YR] * nhanes_chd_cohort[CHD_Flag] ),
    SUM ( nhanes_chd_cohort[WTMEC2YR] )
)

Represented Adults (Millions) =
DIVIDE ( SUM ( nhanes_chd_cohort[WTMEC2YR] ), 1e6 )

Adults With CHD (Millions) =
DIVIDE ( SUMX ( nhanes_chd_cohort, nhanes_chd_cohort[WTMEC2YR] * nhanes_chd_cohort[CHD_Flag] ), 1e6 )

Weighted Prevalence (All Adults) =
CALCULATE ( MAX ( weighted_prevalence[WeightedPrevalence] ), weighted_prevalence[Factor] = "All adults" )

CI Label =
VAR lo = CALCULATE ( MAX ( weighted_prevalence[CI_low] ), weighted_prevalence[Factor] = "All adults" )
VAR hi = CALCULATE ( MAX ( weighted_prevalence[CI_high] ), weighted_prevalence[Factor] = "All adults" )
RETURN FORMAT ( lo, "0.0%" ) & " – " & FORMAT ( hi, "0.0%" )

Weighting Shift =
[Weighted Prevalence (live)] - [CHD Prevalence]     // how much weighting moves the estimate

// ---------- Calibration (page 3) ----------

Brier Score =
MAX ( calibration_summary[Brier] )

Calibration Slope =
MAX ( calibration_summary[CalibrationSlope] )

Calibration In The Large =
MAX ( calibration_summary[MeanPredicted] ) - MAX ( calibration_summary[ObservedRate] )

// ============================================================
// Added in the Power BI build (already in the .pbix)
// Documentation only: everything below already exists in powerbi/NHANES_CHD_Report.pbix,
// which is built from powerbi/pbi_inputs.xlsx (the outputs/ tables reshaped for Power BI).
// In the .pbix the threshold curve table is named `threshold` (not threshold_curve, as above)
// and the pooled tables are prevalence_pooled and odds_ratios_pooled.
// ============================================================

// ---------- Decision-threshold slider (page 2) ----------

// Parameter table (Modeling > New parameter > Numeric range), disconnected from the data:
// 'Threshold choice' = GENERATESERIES ( 0.05, 0.95, 0.05 )   data type: fixed decimal
// Shown as a single-value slider, default 0.40. Because it is not related to `threshold`,
// the curves stay complete while the cards and the reference line follow the slider.

// Measure in threshold
Selected Threshold =
ROUND ( SELECTEDVALUE ( 'Threshold choice'[Threshold choice], 0.4 ), 2 )

// ROUND on both sides avoids floating-point mismatches between the two series.
// REMOVEFILTERS keeps the cards from changing when other visuals are clicked.
Sensitivity at Threshold =
VAR t = [Selected Threshold]
RETURN
    CALCULATE (
        MAX ( threshold[Sensitivity] ),
        REMOVEFILTERS ( threshold ),
        FILTER ( ALL ( threshold[Threshold] ), ROUND ( threshold[Threshold], 2 ) = t )
    )

Specificity at Threshold =
VAR t = [Selected Threshold]
RETURN
    CALCULATE (
        MAX ( threshold[Specificity] ),
        REMOVEFILTERS ( threshold ),
        FILTER ( ALL ( threshold[Threshold] ), ROUND ( threshold[Threshold], 2 ) = t )
    )

Share Flagged =
VAR t = [Selected Threshold]
RETURN
    CALCULATE (
        MAX ( threshold[FlaggedShare] ),
        REMOVEFILTERS ( threshold ),
        FILTER ( ALL ( threshold[Threshold] ), ROUND ( threshold[Threshold], 2 ) = t )
    )

// Threshold chart: Analytics pane > X-axis constant line, value bound to [Selected Threshold]
// (fx > Format style: Field value). This is the orange reference line that moves with the slider.

// ---------- Pooled 2013-March 2020 (page 1) ----------

// Measure in prevalence_pooled. Returns text so the card shows "20,469".
Pooled Adults =
FORMAT (
    CALCULATE ( MAX ( prevalence_pooled[n] ), REMOVEFILTERS ( prevalence_pooled ), prevalence_pooled[Level] = "All adults" ),
    "#,0"
)

// Forest plot as a stacked bar chart on a log x-axis (0.5-4.5), odds_ratios_pooled, one row per Term.
// Segments from left to right: invisible offset up to CI_low, CI line up to just left of the point,
// the point itself (4% of the OR wide, coloured by significance), CI line from just right of the point to CI_high.
// The stacked total is CI_high, so the segment boundaries land at CI_low, 0.98*OR, 1.02*OR and CI_high.
// Format FP Start with no fill; give FP Point Sig and FP Point NS their own colours.
FP Start =
MIN ( odds_ratios_pooled[CI_low] )

FP CI Left =
MIN ( odds_ratios_pooled[OddsRatio] ) * 0.98 - MIN ( odds_ratios_pooled[CI_low] )

FP Point Sig =
IF ( SELECTEDVALUE ( odds_ratios_pooled[Significant] ) = "CI excludes 1", MIN ( odds_ratios_pooled[OddsRatio] ) * 0.04 )

FP Point NS =
IF ( SELECTEDVALUE ( odds_ratios_pooled[Significant] ) = "CI includes 1", MIN ( odds_ratios_pooled[OddsRatio] ) * 0.04 )

FP CI Right =
MIN ( odds_ratios_pooled[CI_high] ) - MIN ( odds_ratios_pooled[OddsRatio] ) * 1.02

// ---------- Calculated columns (Modeling > New column), not measures ----------

// odds_ratios_pooled: 1 = largest odds ratio
OR Rank =
RANKX ( odds_ratios_pooled, odds_ratios_pooled[OddsRatio], , DESC, DENSE )

// odds_ratios_pooled: axis label; Column tools > Sort by column > OR Rank
OR Label =
odds_ratios_pooled[Term] & " " & FORMAT ( odds_ratios_pooled[OddsRatio], "0.00" )
    & " (" & FORMAT ( odds_ratios_pooled[CI_low], "0.00" ) & "–" & FORMAT ( odds_ratios_pooled[CI_high], "0.00" ) & ")"

// funnel: readable step names for the funnel visual
Step Label =
SWITCH (
    funnel[Order],
    1, "Rows after joining 6 files",
    2, "Unique participants",
    3, "Rows with a CHD answer",
    4, "Participants with a CHD answer"
)
